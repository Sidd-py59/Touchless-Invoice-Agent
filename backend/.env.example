# =============================================================================
# TIA backend environment — copy this file to `.env` and fill in your values:
#     cp .env.example .env
# Lines commented out are optional and show their default values.
# =============================================================================

# --- Database -----------------------------------------------------------------
# SQLite file lives in backend/. Alembic migrations are the source of truth;
# missing tables are also auto-created on startup for local dev.
DATABASE_URL=sqlite+aiosqlite:///./tia.db
# AUTO_CREATE_DB_TABLES=true

# --- Groq LLM (OCR correction + voice-agent data Q&A) ---------------------------
# Get a key at https://console.groq.com. Without it, scanned/handwritten OCR
# correction and the agent's free-form data questions are disabled — everything
# else still works.
GROQ_API_KEY=your_groq_api_key
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TABLE_CORRECTION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_AGENT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_REQUEST_TIMEOUT_SECONDS=60

# --- Gmail payroll inbox (touchless mail ingestion) ------------------------------
# TIA polls this mailbox every 30 seconds; any sender can email payroll files
# to it. Setup:
#   1. Google Cloud Console -> new project -> enable "Gmail API".
#   2. OAuth consent screen -> add the mailbox owner as a Test user.
#   3. Credentials -> Create OAuth client ID -> type "Desktop app".
#      Paste the client id/secret below.
#   4. Run `python scripts/gmail_oauth_setup.py` from backend/ and sign in as
#      the mailbox owner — it writes GMAIL_REFRESH_TOKEN here automatically.
# Leave all Gmail values empty to run without mail ingestion.
GMAIL_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_oauth_client_secret
GMAIL_REFRESH_TOKEN=
# The monitored inbox (must be the account that authorized the refresh token):
GMAIL_SYNC_TO_EMAIL=payroll.inbox@example.com
# Restrict to one sender, or leave empty to accept payroll mails from ANYONE:
GMAIL_SYNC_FROM_EMAIL=
# GMAIL_SYNC_MAX_RESULTS=10
# GMAIL_PROCESSED_STORE=storage/gmail_processed.json

# --- Firebase Authentication ------------------------------------------------------
# Users sign in through Firebase on the frontend; the backend verifies their ID
# token on every /api/v1 request. Setup:
#   1. Firebase Console -> Project settings -> Service accounts -> Generate new
#      private key. Save as backend/serviceAccountKey.json (gitignored).
#   2. Grant roles after users sign up:
#        python scripts/set_user_claims.py admin@yourco.com --role admin
#        python scripts/set_user_claims.py client@theirco.com --role client --client-id 1
# Set AUTH_ENABLED=false ONLY for local development without Firebase.
AUTH_ENABLED=true
# FIREBASE_SERVICE_ACCOUNT_FILE=serviceAccountKey.json

# --- API hardening ----------------------------------------------------------------
# Per-IP request budget (sliding 1-minute window) and max upload/body size.
# RATE_LIMIT_PER_MINUTE=240
# MAX_UPLOAD_MB=25
# Disable Swagger/OpenAPI pages in production deployments:
# DOCS_ENABLED=true
# Deployed frontend origin(s), comma-separated (localhost is always allowed):
# EXTRA_CORS_ORIGINS=https://tia.yourcompany.com

# --- Touchless automation --------------------------------------------------------
# For every ingestion source (Gmail, client portal upload, admin upload, email
# body): cleanly validated timesheets get their invoice generated, approved,
# and sent automatically. Timesheets with validation errors go to the human
# review queue; resolving the last error resumes automation.
AUTO_INVOICE=true

# --- Smallest.ai voice output (Finance Agent TTS) --------------------------------
# Get a key at https://smallest.ai. Without it the agent answers in text only.
SMALLEST_API_KEY=your_smallest_ai_key
# SMALLEST_TTS_URL=https://api.smallest.ai/waves/v1/lightning-v3.1/get_speech
# Voices: jessica (default), rachel, david, alex, noah, john
# SMALLEST_VOICE_ID=jessica
# SMALLEST_SAMPLE_RATE=24000
# SMALLEST_OUTPUT_FORMAT=mp3
# SMALLEST_AUDIO_OUTPUT_DIR=storage/voice
