# =============================================================================
# TIA frontend environment — copy to `.env` and fill in your values:
#     cp .env.example .env
# Get these from Firebase Console -> Project settings -> General -> Your apps
# (add a Web app if you haven't). These are public identifiers, not secrets,
# but .env stays untracked anyway.
# Also enable sign-in providers: Firebase Console -> Authentication ->
# Sign-in method -> enable "Email/Password" and "Google".
# =============================================================================
VITE_FIREBASE_API_KEY=your_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
